{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "app: Run FastAPI (uvicorn)",
      "type": "shell",
      "command": "uvicorn main:app --reload",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "test: Run pytest with coverage",
      "type": "shell",
      "command": "python3 -m pytest tests/ -v --cov=docsync --cov-report=term-missing",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
